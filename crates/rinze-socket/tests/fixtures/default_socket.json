[
  {
    "name": "Linux で XDG_RUNTIME_DIR があればその下に置く",
    "os": "linux",
    "env": { "XDG_RUNTIME_DIR": "/run/user/1000", "USER": "alice", "HOME": "/home/alice" },
    "socket": "/run/user/1000/rinze.sock"
  },
  {
    "name": "Linux で XDG_RUNTIME_DIR の末尾に / があっても同じ場所を指す",
    "os": "linux",
    "env": { "XDG_RUNTIME_DIR": "/run/user/1000/", "USER": "alice" },
    "socket": "/run/user/1000/rinze.sock"
  },
  {
    "name": "Linux で XDG_RUNTIME_DIR があれば HOME が無くても決まる",
    "os": "linux",
    "env": { "XDG_RUNTIME_DIR": "/run/user/1000" },
    "socket": "/run/user/1000/rinze.sock"
  },
  {
    "name": "Linux で XDG_RUNTIME_DIR が無く XDG_CACHE_HOME があればその下に置く",
    "os": "linux",
    "env": { "XDG_CACHE_HOME": "/var/cache/alice", "HOME": "/home/alice", "USER": "alice" },
    "socket": "/var/cache/alice/rinze/rinze.sock"
  },
  {
    "name": "Linux で XDG_CACHE_HOME の末尾に / があっても同じ場所を指す",
    "os": "linux",
    "env": { "XDG_CACHE_HOME": "/var/cache/alice/" },
    "socket": "/var/cache/alice/rinze/rinze.sock"
  },
  {
    "name": "Linux で XDG_RUNTIME_DIR と XDG_CACHE_HOME が無ければ HOME/.cache/rinze に置く",
    "os": "linux",
    "env": { "USER": "alice", "HOME": "/home/alice" },
    "socket": "/home/alice/.cache/rinze/rinze.sock"
  },
  {
    "name": "Linux で XDG_RUNTIME_DIR と XDG_CACHE_HOME が空なら無い場合と同じ",
    "os": "linux",
    "env": { "XDG_RUNTIME_DIR": "", "XDG_CACHE_HOME": "", "HOME": "/home/alice", "USER": "alice" },
    "socket": "/home/alice/.cache/rinze/rinze.sock"
  },
  {
    "name": "Linux で XDG_RUNTIME_DIR も XDG_CACHE_HOME も HOME も無ければ決められない",
    "os": "linux",
    "env": { "USER": "alice" },
    "socket": null
  },
  {
    "name": "Linux で HOME が空なら無い場合と同じ",
    "os": "linux",
    "env": { "HOME": "", "USER": "alice" },
    "socket": null
  },
  {
    "name": "macOS では XDG_RUNTIME_DIR と TMPDIR を見ずに HOME の下に置く",
    "os": "macos",
    "env": {
      "HOME": "/Users/alice",
      "XDG_RUNTIME_DIR": "/run/user/501",
      "TMPDIR": "/var/folders/xx/T/",
      "USER": "alice"
    },
    "socket": "/Users/alice/Library/Caches/rinze/rinze.sock"
  },
  {
    "name": "macOS で HOME の末尾に / があっても同じ場所を指す",
    "os": "macos",
    "env": { "HOME": "/Users/alice/" },
    "socket": "/Users/alice/Library/Caches/rinze/rinze.sock"
  },
  {
    "name": "macOS で HOME が無ければ決められない",
    "os": "macos",
    "env": { "XDG_RUNTIME_DIR": "/run/user/501", "USER": "alice" },
    "socket": null
  },
  {
    "name": "macOS で HOME が空なら無い場合と同じ",
    "os": "macos",
    "env": { "HOME": "", "USER": "alice" },
    "socket": null
  }
]
