execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}"
  OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "${NM} で ${LIBRARY} を読めない")
endif()
string(REPLACE "\n" ";" lines "${symbols}")
set(foreign "")
set(count 0)
foreach(line IN LISTS lines)
  if(line STREQUAL "")
    continue()
  endif()
  string(REGEX REPLACE "^.* " "" name "${line}")
  math(EXPR count "${count} + 1")
  if(NOT name MATCHES "^(rinze_.*|fcitx_addon_factory_instance_rinze)$")
    list(APPEND foreign "${name}")
  endif()
endforeach()
if(foreign)
  message(FATAL_ERROR "rinze_ と fcitx5 のアドオンの入口のほかに出しているシンボル: ${foreign}")
endif()
message(STATUS "${LIBRARY} が出すシンボルは ${count} 個で、どれも rinze_ かアドオンの入口")
